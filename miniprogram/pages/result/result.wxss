/* pages/result/result.wxss */

.page {
  min-height: 100vh;
  /* 横向 rpx适配屏宽；纵向 vh适配屏高 */
  padding: 2vh 40rpx calc(3vh + env(safe-area-inset-bottom));
  background: 
    radial-gradient(ellipse at top left, rgba(255, 71, 87, 0.15) 0%, transparent 50%),
    radial-gradient(ellipse at bottom right, rgba(255, 140, 58, 0.1) 0%, transparent 50%),
    #0a0a0a;
  box-sizing: border-box;
}

/* ==== 风格标签 + 收藏按钮 ==== */
.style-tag-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 2.5vh;
}

.style-tag {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #ff4757 0%, #ff8c3a 100%);
  border-radius: 100rpx;
  padding: 14rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 71, 87, 0.3);
}

.fav-toggle {
  padding: 12rpx 26rpx;
  border-radius: 100rpx;
  font-size: 26rpx;
  background: #1a1a1a;
  color: #888;
  border: 1rpx solid #2a2a2a;
  transition: all .18s ease;
}

.fav-toggle.faved {
  background: rgba(255, 82, 82, 0.15);
  color: #ff5252;
  border-color: rgba(255, 82, 82, 0.4);
}
.fav-toggle:active {
  transform: scale(0.94);
}

.tag-emoji {
  font-size: 32rpx;
}

.tag-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

/* ==== 主内容 ==== */
.content-box {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 32rpx;
  padding: 4vh 40rpx;
  margin-bottom: 3vh;
  position: relative;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.quote-mark {
  font-family: Georgia, serif;
  font-size: 96rpx;
  color: rgba(255, 71, 87, 0.35);
  line-height: 0.4;
  font-weight: 900;
}

.quote-mark.end {
  text-align: right;
  margin-top: 20rpx;
}

.content-text {
  font-size: 40rpx;
  line-height: 1.7;
  color: #fff;
  font-weight: 500;
  letter-spacing: 1rpx;
  margin: 30rpx 0;
  text-shadow: 0 2rpx 10rpx rgba(255, 71, 87, 0.2);
  /* 最多显示 8 行（约 120 字），超长自动省略，保证卡片首屏可见 */
  display: -webkit-box;
  -webkit-line-clamp: 8;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ==== 卡片预览 ==== */
.card-preview {
  margin-bottom: 2.5vh;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.preview-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 20rpx;
  font-weight: 500;
}

.card-image {
  width: 100%;
  border-radius: 16rpx;
  display: block;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.5);
}

.preview-tip {
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 20rpx;
}

/* ==== 模板选择 ==== */
.template-wrap {
  margin-bottom: 2.5vh;
}

.input-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-bottom: 20rpx;
  font-weight: 500;
}

.dot {
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #ff4757, #ff8c3a);
  border-radius: 4rpx;
  display: inline-block;
}

.template-scroll {
  width: 100%;
  white-space: nowrap;
}

.template-list {
  display: inline-flex;
  gap: 20rpx;
  padding: 4rpx 2rpx 12rpx;
}

.template-item {
  flex: 0 0 auto;
  width: 160rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  transition: all 0.2s;
}

.template-item.active {
  background: rgba(255, 71, 87, 0.12);
  border-color: #ff4757;
  box-shadow: 0 8rpx 24rpx rgba(255, 71, 87, 0.2);
}

/* 正在生成时，选中的模板项做呼吸态提示 */
.template-item.loading {
  animation: template-breathing 1.2s ease-in-out infinite;
}

@keyframes template-breathing {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

.template-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.template-name {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

/* ==== 操作按钮 ==== */
.actions {
  margin-top: 20rpx;
}

.primary-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 !important;
  font-size: 32rpx;
  border-radius: 100rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #ff4757 0%, #ff8c3a 100%) !important;
  color: #fff !important;
  box-shadow: 0 10rpx 30rpx rgba(255, 71, 87, 0.35);
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.g-btn-ghost.full {
  width: 100%;
  margin-bottom: 20rpx;
}

/* 两按钮同一行：flex:1 平分；单按钮存在时自动铺满整行 */
.btn-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.btn-row .row-btn {
  flex: 1;
  margin: 0 !important;
  padding: 0 !important;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 500;
  min-width: 0; /* 允许弹性收缩，避免文字过长撑破布局 */
}

.again-btn {
  color: rgba(255, 255, 255, 0.7) !important;
  border-color: rgba(255, 255, 255, 0.15) !important;
}

/* ==== 免责声明 ==== */
.disclaimer {
  text-align: center;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 0.5rpx;
  line-height: 1.6;
}