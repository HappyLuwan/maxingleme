<!-- pages/result/result.wxml -->
<view class="page">
  <!-- 顶部风格标签 + 收藏按钮 -->
  <view class="style-tag-row">
    <view class="style-tag">
      <text class="tag-emoji">{{roast.styleEmoji}}</text>
      <text class="tag-name">{{roast.styleName}} 风</text>
    </view>
    <view class="fav-toggle {{isFavorite ? 'faved' : ''}}" bindtap="onToggleFavorite">
      <text>{{isFavorite ? '❤ 已收藏' : '♡ 收藏'}}</text>
    </view>
  </view>

  <!-- 主内容：AI 骂醒文案 -->
  <view class="content-box">
    <view class="quote-mark">"</view>
    <view class="content-text">{{roast.content}}</view>
    <view class="quote-mark end">"</view>
  </view>

  <!-- 卡片预览区 -->
  <view wx:if="{{cardImageUrl}}" class="card-preview">
    <view class="preview-label">
      <text>🎨 分享卡片已生成</text>
    </view>
    <image class="card-image" src="{{cardImageUrl}}" mode="widthFix" show-menu-by-longpress="{{true}}"/>
    <view class="preview-tip">长按图片可保存 / 分享</view>
  </view>

  <!-- 模板选择 -->
  <view class="template-wrap">
    <view class="input-label">
      <text class="dot"></text>
      <text>{{cardImageUrl ? '换一个卡片风格' : '选一个卡片风格，生成分享图 →'}}</text>
    </view>
    <scroll-view class="template-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="template-list">
        <view wx:for="{{templates}}"
              wx:key="key"
              class="template-item {{selectedTemplate === item.key ? 'active' : ''}} {{generatingCard && selectedTemplate === item.key ? 'loading' : ''}}"
              data-key="{{item.key}}"
              bindtap="onSelectTemplate">
          <view class="template-icon">{{item.icon}}</view>
          <view class="template-name">{{item.name}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <!-- 主 CTA：分享 -->
    <button class="g-btn primary-btn"
            open-type="share">
      📤 分享给朋友
    </button>

    <!-- 次级操作：保存 + 再来一次（同一行） -->
    <view class="btn-row">
      <button class="g-btn-ghost row-btn"
              wx:if="{{cardImageUrl}}"
              bindtap="onSaveImage">
        📥 保存到相册
      </button>

      <button class="g-btn-ghost row-btn again-btn" bindtap="onAgain">
        🔥 换个烦恼
      </button>
    </view>

    <view class="disclaimer">
      ⚠️ 内容由 AI 生成，不构成任何专业建议，危险情况请寻求救助
    </view>
  </view>
</view>
