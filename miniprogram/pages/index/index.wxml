<!-- pages/index/index.wxml -->
<view class="page">
  <!-- 顶部品牌区 -->
  <view class="header">
    <view class="logo">
      <text class="logo-fire">🔥</text>
      <text class="logo-text">骂醒了么</text>
    </view>
<view class="slogan">今天又被自己感动了嘛？快醒醒</view>
  </view>

  <!-- 输入区 -->
  <view class="input-wrap">
    <view class="input-label">
      <text class="dot"></text>
      <text>说说你的困扰，让我来骂醒你!</text>
    </view>
    <textarea class="input-area"
              placeholder="{{selectedStyle === 'custom' ? '输入你想放在海报上的一句话文案...' : '例如：前任又来找我了，我心动了...'}}"
              placeholder-class="input-placeholder"
              maxlength="500"
              value="{{userInput}}"
              bindinput="onInput"
              auto-height
              hold-keyboard="{{true}}"
              cursor-spacing="20"/>
    <view class="input-footer">
      <text class="text-hint">{{userInput.length}}/500</text>
    </view>
  </view>

  <!-- 风格选择 -->
  <view class="style-wrap">
    <view class="input-label">
      <text class="dot"></text>
      <text>选一个骂醒风格</text>
    </view>
    <view class="style-grid">
      <view wx:for="{{styles}}"
            wx:key="key"
            class="style-item {{selectedStyle === item.key ? 'active' : ''}} {{!item.enabled ? 'disabled' : ''}} {{item.key === 'custom' ? 'style-item-wide' : ''}}"
            data-key="{{item.key}}"
            bindtap="onSelectStyle">
        <view class="style-emoji">{{item.emoji}}</view>
        <view class="style-name">{{item.name}}</view>
        <view wx:if="{{item.key === 'yiju'}}" class="style-badge">推荐分享</view>
        <view wx:if="{{item.key === 'custom'}}" class="style-badge style-badge-custom">不调用AI</view>
        <view wx:if="{{!item.enabled}}" class="soon-tag">敬请期待</view>
      </view>
    </view>
  </view>

  <!-- 骂醒按钮 -->
  <view class="action-wrap">
    <button class="g-btn action-btn"
            disabled="{{loading || !canSubmit}}"
            bindtap="onRoast">
      {{loading ? (selectedStyle === 'custom' ? '正在生成卡片...' : '正在骂醒你...') : (selectedStyle === 'custom' ? '生成金句海报 →' : '狠狠骂醒我 →')}}
    </button>
  </view>

  <!-- 底部示例 -->
  <view class="examples">
    <view class="examples-title">🌰 灵感示例（点一下自动填入）</view>
    <view wx:for="{{examples}}"
          wx:key="index"
          class="example-item"
          data-text="{{item}}"
          bindtap="onExampleTap">
      <text>{{item}}</text>
    </view>
  </view>
</view>
