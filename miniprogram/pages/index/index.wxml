<!-- pages/index/index.wxml -->
<view class="page">
  <!-- 顶部品牌区 -->
  <view class="header">
    <view class="logo">
      <text class="logo-fire">🔥</text>
      <text class="logo-text">骂醒了么</text>
    </view>
    <view class="slogan">今天，你被自己感动到了么？</view>
  </view>

  <!-- 输入区 -->
  <view class="input-wrap">
    <view class="input-label">
      <text class="dot"></text>
      <text>说说你的困扰，让 AI 一句话骂醒你</text>
    </view>
    <textarea class="input-area"
              placeholder="例如：前任又来找我了，我心动了..."
              placeholder-class="input-placeholder"
              maxlength="500"
              value="{{userInput}}"
              bindinput="onInput"
              auto-height
              hold-keyboard="{{true}}"
              cursor-spacing="20"/>
    <view class="input-footer">
      <text class="text-hint">{{userInput.length}}/500</text>
    </view>
  </view>

  <!-- 风格选择 -->
  <view class="style-wrap">
    <view class="input-label">
      <text class="dot"></text>
      <text>选一个骂醒风格</text>
    </view>
    <view class="style-grid">
      <view wx:for="{{styles}}"
            wx:key="key"
            class="style-item {{selectedStyle === item.key ? 'active' : ''}} {{!item.enabled ? 'disabled' : ''}}"
            data-key="{{item.key}}"
            bindtap="onSelectStyle">
        <view class="style-emoji">{{item.emoji}}</view>
        <view class="style-name">{{item.name}}</view>
        <view class="style-desc">{{item.description}}</view>
        <view wx:if="{{!item.enabled}}" class="soon-tag">敬请期待</view>
      </view>
    </view>
  </view>

  <!-- 骂醒按钮 -->
  <view class="action-wrap">
    <button class="g-btn action-btn"
            loading="{{loading}}"
            disabled="{{loading || !canSubmit}}"
            bindtap="onRoast">
      {{loading ? '正在骂醒你...' : '狠狠骂醒我 →'}}
    </button>
    <view class="tip">
      <text>💡 骂完可以生成精美卡片分享给朋友</text>
    </view>
  </view>

  <!-- 底部示例 -->
  <view class="examples">
    <view class="examples-title">🌰 灵感示例（点一下自动填入）</view>
    <view wx:for="{{examples}}"
          wx:key="index"
          class="example-item"
          data-text="{{item}}"
          bindtap="onExampleTap">
      <text>{{item}}</text>
    </view>
  </view>
</view>
