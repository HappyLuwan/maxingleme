/* pages/about/about.wxss */
.page {
  min-height: 100vh;
  padding: 40rpx 40rpx calc(60rpx + env(safe-area-inset-bottom));
  background: 
    radial-gradient(ellipse at top left, rgba(255, 71, 87, 0.15) 0%, transparent 50%),
    radial-gradient(ellipse at bottom right, rgba(255, 140, 58, 0.1) 0%, transparent 50%),
    #0a0a0a;
  box-sizing: border-box;
}

/* ==== 品牌区 ==== */
.brand {
  text-align: center;
  padding: 40rpx 0 50rpx;
}

.logo-fire {
  font-size: 96rpx;
  line-height: 1;
  margin-bottom: 20rpx;
}

.brand-name {
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  background: linear-gradient(135deg, #ff4757 0%, #ff8c3a 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 12rpx;
}

.brand-slogan {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.version {
  display: inline-block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  padding: 4rpx 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 100rpx;
}

/* ==== 卡片 ==== */
.card {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 24rpx;
  padding-left: 20rpx;
  border-left: 6rpx solid #ff4757;
  line-height: 1.2;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.row-value {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

.icp-pending {
  color: #ff8c3a;
}

.icp-ok {
  color: #4ecdc4;
}

/* ==== 使用须知 ==== */
.notice-card {
  background: rgba(255, 71, 87, 0.08);
  border-color: rgba(255, 71, 87, 0.2);
}

.notice-text {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.8;
  margin-bottom: 12rpx;
}

.notice-text:last-child {
  margin-bottom: 0;
}

.hotline {
  color: #ff8c3a;
  font-weight: 700;
  text-decoration: underline;
}

/* ==== 导航列表 ==== */
.nav-list {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  margin-bottom: 40rpx;
}

.nav-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.nav-item:last-child {
  border-bottom: none;
}

.nav-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}

.nav-text {
  flex: 1;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

.nav-arrow {
  color: rgba(255, 255, 255, 0.3);
  font-size: 40rpx;
  line-height: 1;
}

/* ==== 底部 ==== */
.footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
  letter-spacing: 1rpx;
}

.footer-tip {
  margin-top: 8rpx;
}
