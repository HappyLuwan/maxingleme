<!-- pages/about/about.wxml -->
<view class="page">
  <!-- 品牌区 -->
  <view class="brand">
    <view class="logo-fire">🔥</view>
    <view class="brand-name">骂醒了么</view>
    <view class="brand-slogan">金句一句骂醒你 · 治愈自我感动</view>
    <view class="version">v{{version}}</view>
  </view>

  <!-- 服务信息 -->
  <view class="card">
    <view class="card-title">服务信息</view>
    <view class="row">
      <text class="row-label">服务性质</text>
      <text class="row-value">娱乐性文本小工具</text>
    </view>
    <view class="row">
      <text class="row-label">主体</text>
      <text class="row-value">个人开发者</text>
    </view>
    <view class="row">
      <text class="row-label">运营地区</text>
      <text class="row-value">中国大陆</text>
    </view>
    <view class="row" bindtap="onCopy" data-text="{{icpNo}}">
      <text class="row-label">备案号</text>
      <text class="row-value {{hasIcp ? 'icp-ok' : 'icp-pending'}}">{{icpNo}}</text>
    </view>
  </view>

  <!-- 用户须知 -->
  <view class="card notice-card">
    <view class="card-title">⚠️ 使用须知</view>
    <view class="notice-text">本小程序所有文案均为人工创作，仅供娱乐参考，不构成任何专业心理咨询、医疗、法律或投资建议。</view>
    <view class="notice-text">若你正处于严重情绪困扰，请拨打全国心理援助热线 <text class="hotline" bindtap="onCopy" data-text="400-161-9995">400-161-9995</text>。</view>
  </view>

  <!-- 协议入口 -->
  <view class="nav-list">
    <view class="nav-item" bindtap="onNavAgreement">
      <text class="nav-icon">📄</text>
      <text class="nav-text">用户服务协议</text>
      <text class="nav-arrow">›</text>
    </view>
    <view class="nav-item" bindtap="onNavPrivacy">
      <text class="nav-icon">🔒</text>
      <text class="nav-text">隐私政策</text>
      <text class="nav-arrow">›</text>
    </view>
    <view class="nav-item" bindtap="onFeedback">
      <text class="nav-icon">💬</text>
      <text class="nav-text">意见反馈</text>
      <text class="nav-arrow">›</text>
    </view>
  </view>

  <!-- 底部版权 -->
  <view class="footer">
    <view>© 2026 骂醒了么</view>
    <view class="footer-tip">感谢你的信任 · 请理性使用</view>
  </view>
</view>
