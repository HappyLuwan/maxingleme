# ==========================================
# 本地开发环境变量示例
# 复制为 .env 并填入真实值，或在 docker/云托管配置中注入
# ==========================================

# ---------- 端口 ----------
PORT=8080

# ---------- AI Provider ----------
# 当前启用的 provider：deepseek | hunyuan | doubao | qwen | mock
AI_ACTIVE_PROVIDER=deepseek
# 兜底 provider（当 active 失败自动切换）
AI_FALLBACK_PROVIDER=hunyuan

# DeepSeek（推荐首选，性价比最高）
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_ENABLED=true

# 腾讯混元
HUNYUAN_API_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_API_KEY=
HUNYUAN_MODEL=hunyuan-lite
HUNYUAN_ENABLED=true

# 字节豆包（可选）
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-lite-4k
DOUBAO_ENABLED=false

# 阿里通义千问（可选）
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-turbo
QWEN_ENABLED=false

# ---------- 卡片 ----------
CARD_OUTPUT_DIR=/tmp/mxlm-cards
CARD_PLAYWRIGHT_ENABLED=true

# ---------- 数据库 ----------
# 存储后端：mysql（生产/云托管推荐）| sqlite（本地开发兜底）
DB_BACKEND=mysql

# --- MySQL（DB_BACKEND=mysql 时生效）---
# 云托管场景填内网地址（形如 10.x.x.x:3306），本地开发可指向自建/远程 MySQL
DB_HOST=10.18.100.131
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mxlm
DB_POOL_SIZE=5

# --- SQLite（DB_BACKEND=sqlite 时生效，兜底）---
# 文件路径。默认 ./data/mxlm.db
# ⚠️ SQLite 不支持多实例并发写，走 SQLite 时云托管必须锁定 Min=Max=1
DB_PATH=

# ---------- 管理后台 ----------
ADMIN_TOKEN=mxlm-admin-2026

# ---------- 内容安全 ----------
# 微信 msgSecCheck 兜底开关：
# - 生产/云托管环境：true（免费调用，无需 access_token）
# - 本地开发：建议 false，避免非云托管环境无谓请求
WX_MSG_SEC_CHECK_ENABLED=true
# 强制标记当前运行在云托管（供 msgSecCheck 判断走内网 API）
# 云托管默认注入 TCB_ENV/CBS_SERVICE_TYPE 即可自动识别；此项仅在识别不到时手动开启
# WX_CLOUDBASE=1
