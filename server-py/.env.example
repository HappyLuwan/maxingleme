# ==========================================
# 环境变量模板（复制为 .env 或在云托管控制台配置）
# ==========================================

# ---------- 服务端口 ----------
PORT=8080

# ---------- 文案生成 ----------
# 仅使用本地精选文案库（人工创作 + 关键词匹配）
# 不涉及任何生成式 AI / 深度合成技术
AI_ACTIVE_PROVIDER=local
AI_FALLBACK_PROVIDER=local

# ---------- 卡片 ----------
CARD_OUTPUT_DIR=/tmp/mxlm-cards
CARD_PLAYWRIGHT_ENABLED=true

# ---------- 数据库 ----------
# 本地开发：sqlite（零依赖）
# 云托管生产：mysql
DB_BACKEND=sqlite
DB_PATH=./data/mxlm.db

# 云托管生产需要的 MySQL 配置（DB_BACKEND=mysql 时启用）
# DB_HOST=<云数据库内网IP>
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=<强密码>
# DB_NAME=mxlm

# ---------- 管理后台 ----------
# 生产环境必须改成强密码（20 位以上随机字符）
ADMIN_TOKEN=change-me-to-strong-token

# ---------- 内容安全 ----------
# 本地关闭；云托管必须开启
WX_MSG_SEC_CHECK_ENABLED=false

# 微信小程序 AppID / AppSecret（msgSecCheck 需要）
# WX_APPID=
# WX_APPSECRET=
